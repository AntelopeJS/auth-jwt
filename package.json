{
  "name": "@antelopejs/auth-jwt",
  "version": "2.0.0",
  "description": "JWT authentication module for AntelopeJS, implementing the Auth interface with jsonwebtoken",
  "keywords": [
    "antelopejs",
    "auth",
    "authentication",
    "authorization",
    "jsonwebtoken",
    "jwt"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/auth/introduction",
  "bugs": {
    "url": "https://github.com/AntelopeJS/auth-jwt/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/auth-jwt.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project dev -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint && antelopejs-check-interface-ranges",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "typecheck": "tsc --noEmit",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-auth": "file:.campaign/tgz/antelopejs-interface-auth-6c75264.tgz",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "chai": "^4.5.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/chai": "^4.3.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-auth": "file:.campaign/tgz/antelopejs-interface-auth-6c75264.tgz"
    }
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-auth"
    ],
    "defaultConfig": {
      "secret": "your-secret-key"
    },
    "test": "src/test/antelope.test.ts"
  }
}
