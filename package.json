{
  "name": "@antelopejs/auth-jwt",
  "version": "1.0.3",
  "description": "Authentication and authorization module that implements the Auth interface of antelopejs with JWT",
  "keywords": [
    "antelope",
    "auth",
    "authentication",
    "authorization",
    "jwt"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/auth.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-auth": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0",
    "chai": "^4.5.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.9.1",
    "@antelopejs/tooling-configs": "^0.0.6",
    "@types/chai": "^4.3.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-auth"
    ],
    "defaultConfig": {
      "secret": "your-secret-key"
    },
    "test": "src/test/antelope.test.ts"
  }
}
